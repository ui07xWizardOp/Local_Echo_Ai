# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/local_echo_ai
# For development with SQLite: DATABASE_URL=sqlite:///local_echo.db

# Session Security
SESSION_SECRET=your-long-random-secret-key-here

# AI Services
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio

# Google Cloud Services (Optional)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Indian Service Providers (Production)
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
GUPSHUP_API_KEY=your-gupshup-whatsapp-key

# Application Settings
FLASK_ENV=development
DEBUG=True
PORT=5000
HOST=0.0.0.0